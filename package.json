{
  "name": "foodly-notes-api-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings src test scripts serverless.ts vitest.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --ignore-path .gitignore --write .",
    "format:check": "prettier --ignore-path .gitignore --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@middy/core": "7.9.2",
    "ajv": "8.20.0",
    "ipaddr.js": "2.5.0",
    "mongoose": "9.11.4",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "esbuild": "0.28.2",
    "mongodb-memory-server": "11.3.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "serverless": "4.45.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
