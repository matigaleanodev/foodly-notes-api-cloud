{
  "name": "foodly-notes-api-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings packages test scripts vitest.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --ignore-path .gitignore --write .",
    "format:check": "prettier --ignore-path .gitignore --check .",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspace=@foodly-notes/runtime",
    "openapi": "npm run openapi --workspace=@foodly-notes/contracts",
    "check": "npm run boundaries && npm run lint && npm run format:check && npm run typecheck && npm test && npm run openapi && npm run build && npm run synth:local",
    "synth": "npm run synth --workspace=@foodly-notes/infrastructure --",
    "synth:local": "node scripts/synth-local.mjs",
    "boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@foodly-notes/contracts": "0.1.0",
    "@foodly-notes/infrastructure": "0.1.0",
    "@foodly-notes/runtime": "0.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "aws-cdk-lib": "2.275.0",
    "esbuild": "0.28.2",
    "mongodb-memory-server": "11.3.0",
    "mongoose": "9.11.4",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*"
  ]
}
